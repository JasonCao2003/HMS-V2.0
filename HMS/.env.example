# ============================================================
# HMS 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 说明：项目通过 spring-dotenv 自动加载本项目根目录下的 .env 文件。
# ============================================================

# ---------- 服务器 ----------
SERVER_PORT=8080

# ---------- 文件上传目录 ----------
# Windows 示例: D:/Code/HMS/photo
PHOTO_FILE_DIR=D:/Code/HMS/photo

# ---------- MySQL ----------
MYSQL_URL=jdbc:mysql://localhost:3306/hms?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# ---------- 邮箱（发件，QQ 邮箱示例） ----------
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=your_qq@qq.com
MAIL_PASSWORD=your_qq_smtp_authorization_code

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 支付宝（沙箱） ----------
ALIPAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APPID=your_alipay_appid
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=http://localhost:8080/notify
ALIPAY_RETURN_URL=http://localhost:8080/return
