# ============================================================
# DataForcast 环境变量模板（Python 侧）
# Notebook 通过 os.environ 读取 MYSQL_PASSWORD，避免硬编码口令。
# 用法：复制为 .env 并填入真实值，然后在运行前导出：
#   cp .env.example .env
#   set -a; source .env; set +a
# （.env 已被 .gitignore 忽略，不会提交）
# ============================================================

MYSQL_PASSWORD=your_mysql_password
